{
    "name": "markup-carve/carve-php",
    "description": "PHP parser for Carve, a lightweight markup language for documents and the web.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "carve",
        "markup",
        "parser",
        "djot"
    ],
    "homepage": "https://markup-carve.github.io/carve/",
    "authors": [
        {
            "name": "Mark Scherer",
            "homepage": "https://github.com/dereuromark"
        },
        {
            "name": "PHP Collective (djot-php, upstream)",
            "homepage": "https://github.com/php-collective"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "suggest": {
        "ext-dom": "Required for HTML import and HTML heading-ID conversion.",
        "ext-intl": "Recommended for heading-ID transliteration: enables ICU romanization of non-Latin scripts (e.g. CJK, Arabic). Without it, a baked map covers Latin/Cyrillic/punctuation identically and other scripts fall back to the generated `section` id."
    },
    "_comment": "phpunit is held below 13.4 until paratest supports it. 13.4.0 made the constructor of PHPUnit's internal PhpHandler take a required argument, and paratest v7.25.0 calls it with none (paratestphp/paratest#1143). Temporary: widen the 13.x bound back to ^13.0 once a paratest release resolves against 13.4.",
    "require-dev": {
        "brianium/paratest": "^7.8",
        "nikic/php-fuzzer": "^0.0.11",
        "php-collective/code-sniffer": "^0.6.8",
        "phpstan/phpstan": "^2.1.32",
        "phpunit/phpunit": "^11.0 || ^12.0 || ~13.3.0"
    },
    "autoload": {
        "psr-4": {
            "MarkupCarve\\Carve\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkupCarve\\Carve\\Test\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@stan",
            "@test"
        ],
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "fuzz": "php-fuzzer fuzz fuzz/target.php fuzz/corpus/",
        "fuzz-strict": "php-fuzzer fuzz fuzz/target-strict.php fuzz/corpus/",
        "schema-map-check": "@php scripts/check-schema-map.php",
        "stan": "phpstan analyze",
        "test": "@php -d pcov.enabled=0 vendor/bin/phpunit",
        "test-parallel": "@php -d pcov.enabled=0 vendor/bin/paratest --passthru-php=\"-d pcov.enabled=0\"",
        "test-all": [
            "@test",
            "@test-scaling"
        ],
        "test-coverage": "@php vendor/bin/phpunit --coverage-clover coverage.xml",
        "test-coverage-parallel": "@php vendor/bin/paratest --coverage-clover coverage.xml",
        "test-scaling": "@php -d pcov.enabled=0 vendor/bin/phpunit --group scaling"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "bin": [
        "bin/carve"
    ]
}
