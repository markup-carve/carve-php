<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnDeprecation="true"
         defaultTestSuite="default">
    <testsuites>
        <testsuite name="default">
            <directory>tests/</directory>
            <!-- markup-carve/carve spec corpus submodule; no PHP tests live there -->
            <exclude>tests/spec</exclude>
        </testsuite>
    </testsuites>
    <!--
        The scaling guards measure wall-clock cost per input byte to catch a
        reintroduced O(n^2) scan. 49 data sets convert a 50000-repeat input
        several times each, which is most of the suite's runtime, and the
        measurement is only meaningful on an unloaded runner. They are excluded
        from the default run and covered by their own CI job (composer
        test-scaling), so the everyday suite stays fast and parallelizable.
    -->
    <groups>
        <exclude>
            <group>scaling</group>
        </exclude>
    </groups>
    <source>
        <include>
            <directory suffix=".php">src/</directory>
        </include>
    </source>
</phpunit>
