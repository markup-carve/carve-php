{
  "version": 1,
  "about": "ProseMirror wire fixtures. One Carve source per construct and the EXACT ProseMirror document a bridge must produce for it, attribute names included. schema-map.json names the nodes and their attributes; these pin the shape, which is the half that drifted: two bridges to this model produced different attribute vocabularies for the same document and nothing compared them. A bridge in another runtime copies this file and asserts against it.",
  "cases": [
    {
      "name": "paragraph-with-attributes",
      "carve": "{#p1 .lead data-x=1}\nHello *world*.\n",
      "pm": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Hello "
              },
              {
                "type": "text",
                "text": "world",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": "."
              }
            ],
            "attrs": {
              "id": "p1",
              "class": "lead",
              "carveKeyValues": {
                "data-x": "1"
              },
              "carveAttrOrder": [
                "#id",
                ".class",
                "data-x"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "heading-with-attributes",
      "carve": "{#h .big}\n## A heading\n",
      "pm": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2,
              "id": "h",
              "class": "big",
              "carveAttrOrder": [
                "#id",
                ".class"
              ]
            },
            "content": [
              {
                "type": "text",
                "text": "A heading"
              }
            ]
          }
        ]
      }
    },
