    "html": "<p>a <a id=\"fnref1\" href=\"#fn1\" role=\"doc-noteref\"><sup>1</sup></a> b</p>\n<section role=\"doc-endnotes\" aria-label=\"Footnotes\">\n  <hr>\n  <ol>\n    <li id=\"fn1\">\n      <p>see <a href=\"/u\">x</a><a href=\"#fnref1\" role=\"doc-backlink\" aria-label=\"Back to reference\">↩</a></p>\n    </li>\n  </ol>\n</section>\n"
  },
  {
    "id": "footnote-link-sup/573-a-footnote-reference-in-link-text-keeps-its-id-on-the-sup-2",
    "source": "a [t[^named]{data-carve-footnote-label=\"named\"}][r] b\n\n[r]: /u\n\n[^named]: n\n",
    "html": "<p>a <a href=\"/u\">t<sup id=\"fnref1\" data-carve-footnote-label=\"named\">1</sup></a> b</p>\n<section role=\"doc-endnotes\" aria-label=\"Footnotes\">\n  <hr>\n  <ol>\n    <li id=\"fn1\">\n      <p>n<a href=\"#fnref1\" role=\"doc-backlink\" aria-label=\"Back to reference\">↩</a></p>\n    </li>\n  </ol>\n</section>\n"
  },
  {
