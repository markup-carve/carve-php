  },
  {
    "name": "an admonition kind at depth 2",
    "source": "> > ::: note\n> > :::\ny\n",
    "html": "<blockquote>\n  <blockquote>\n    <aside class=\"admonition note\" aria-label=\"Note\">\n\n    </aside>\n  </blockquote>\n</blockquote>\n<p>y</p>"
  },
  {
    "name": "depth 1 is unchanged",
    "source": "> :::\n> :::\ny\n",
    "html": "<blockquote>\n  <div>\n\n  </div>\n</blockquote>\n<p>y</p>"
  },
  {
    "name": "an unterminated div at depth 2 still claims the line",
    "source": "> > :::\n> > p\ny\n",
    "html": "<blockquote>\n  <blockquote>\n    <div>\n      <p>p\ny</p>\n    </div>\n  </blockquote>\n</blockquote>"
  },
  {
    "name": "a closer one level shallower than the opener",
    "source": "> > :::\n> :::\ny\n",
    "html": "<blockquote>\n  <blockquote>\n    <div>\n\n    </div>\n  </blockquote>\n  <div>\n\n  </div>\n</blockquote>\n<p>y</p>"
  },
  {
    "name": "a wider closer does not close a narrower div",
