# Define the line ending behavior of the different file extensions
# Set default behavior, in case users don't have core.autocrlf set.
* text=auto eol=lf

*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary

# Remove files for archives generated using `git archive`
phpunit.xml.dist export-ignore
.github export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
tests/ export-ignore
bench/ export-ignore
oracle/ export-ignore
scripts/ export-ignore
docs/ export-ignore
spec/conformance/ export-ignore
spec/trees/ export-ignore
phpcs.xml export-ignore
phpstan.neon export-ignore
renovate.json export-ignore
.changelog-exempt export-ignore
# spec/data feeds scripts/generate-tables.php and the tests; only the files src/ reads at runtime ship
# (tests/Build/DistArchiveTest.php keeps this list in step with src/).
spec/data/* export-ignore
spec/data/cli.json -export-ignore
spec/data/annotation-ranges.schema.json -export-ignore
spec/data/ast-schema.json -export-ignore
spec/data/layout-schema.json -export-ignore
spec/data/lint-model.json -export-ignore
spec/data/lint-rules.json -export-ignore
spec/data/node-slots.json -export-ignore
