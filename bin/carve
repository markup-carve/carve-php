#!/usr/bin/env php
<?php

declare(strict_types=1);

use MarkupCarve\Carve\Cli\Command;

// Composer's bin proxy names the autoloader of the consuming project; a checkout uses its own.
require $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__) . '/vendor/autoload.php';

exit(Command::main(array_slice($argv, 1), STDIN, STDOUT, STDERR));
