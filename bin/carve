#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Carve CLI - Convert carve files to HTML
 *
 * Usage:
 *   carve fmt [--write|--check] [--stamp|--stamp-block] [files...]
 *   carve lint [--platform <name>] [files...]
 *   carve merge [--json] base ours theirs
 *   carve migrate --from <html|markdown|djot|bbcode> [options] [input-file]
 *   carve [options] [input-file]
 *   cat file.crv | carve [options]
 *
 * Options:
 *   -o, --output FILE Write output to FILE instead of stdout
 *   -x, --xhtml Use XHTML-compatible output
 *   -s, --safe Enable safe mode (sanitize HTML)
 *   --static Render in static mode (flatten interactive constructs; HTML only)
 *   -w, --warnings Show parse warnings on stderr
 *   --strict Exit with error if warnings are generated
 *   -h, --help Show this help message
 *   -v, --version Show version information
 */

// Find autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaderFound = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require $autoloadPath;
        $autoloaderFound = true;

        break;
    }
}

if (!$autoloaderFound) {
    fwrite(STDERR, "Error: Could not find Composer autoloader.\n");
    fwrite(STDERR, "Please run 'composer install' first.\n");
    exit(1);
}

use MarkupCarve\Carve\Ast\AstCodec;
use MarkupCarve\Carve\Ast\AstMerge;
use MarkupCarve\Carve\CarveConverter;
use MarkupCarve\Carve\Converter\BbcodeToCarve;
use MarkupCarve\Carve\Converter\DjotToCarve;
use MarkupCarve\Carve\Converter\HtmlToCarve;
use MarkupCarve\Carve\Converter\MarkdownToCarve;
use MarkupCarve\Carve\Exception\RenderDepthExceededException;
use MarkupCarve\Carve\Extension\CodeGroupExtension;
use MarkupCarve\Carve\Extension\DetailsExtension;
use MarkupCarve\Carve\Extension\FencedRenderExtension;
use MarkupCarve\Carve\Extension\MathBlockExtension;
use MarkupCarve\Carve\Extension\SpoilerExtension;
use MarkupCarve\Carve\Extension\TabsExtension;
use MarkupCarve\Carve\Lint\FigureGroupLinter;
use MarkupCarve\Carve\Lint\MarkdownHabitLinter;
use MarkupCarve\Carve\Lint\QuoteFenceLinter;
use MarkupCarve\Carve\Lint\RetiredSpellingLinter;
use MarkupCarve\Carve\Lint\SemanticAttributeLinter;
use MarkupCarve\Carve\Lint\TableColumnLinter;
use MarkupCarve\Carve\Lint\TemplateSourceLinter;
use MarkupCarve\Carve\Parser\BlockParser;
use MarkupCarve\Carve\Renderer\AnsiRenderer;
use MarkupCarve\Carve\Renderer\HtmlRenderer;
use MarkupCarve\Carve\Renderer\MarkdownRenderer;
use MarkupCarve\Carve\Renderer\PlainTextRenderer;
use MarkupCarve\Carve\Renderer\RenderMode;
use MarkupCarve\Carve\Renderer\SmartTypographyMode;
use MarkupCarve\Carve\RenderResult;
use MarkupCarve\Carve\Stamp;

/**
 * @param array<int, string> $argv
 */
function runMergeCommand(array $argv): never
{
    $json = false;
    $files = [];
    foreach (array_slice($argv, 2) as $arg) {
        if ($arg === '--json') {
            $json = true;
        } elseif ($arg === '-h' || $arg === '--help') {
            fwrite(STDOUT, "Usage: carve merge [--json] base ours theirs\n");
            exit(0);
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "carve merge: unknown option: $arg\n");
            exit(2);
        } else {
            $files[] = $arg;
        }
    }
    if (count($files) !== 3) {
        fwrite(STDERR, "carve merge: takes exactly three files (base, ours, theirs)\n");
        exit(2);
    }
    $codec = new AstCodec();
    $converter = new CarveConverter(parser: new BlockParser(false, false, false, true));
    $trees = [];
    foreach ($files as $file) {
        if (!is_file($file) || !is_readable($file)) {
            fwrite(STDERR, "carve merge: cannot read $file\n");
            exit(2);
        }
        $source = file_get_contents($file);
        if ($source === false) {
            fwrite(STDERR, "carve merge: cannot read $file\n");
            exit(2);
        }
        $trees[] = $codec->encode($converter->parse($source));
    }
    $result = AstMerge::merge($trees[0], $trees[1], $trees[2]);
    if (!$result['ok']) {
        if ($json) {
            fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
        } else {
            foreach ($result['conflicts'] as $conflict) {
                fwrite(STDERR, sprintf("conflict %s at %s\n", $conflict['reason'], $conflict['path']));
            }
            $count = count($result['conflicts']);
            fwrite(STDERR, sprintf("%d structural conflict%s\n", $count, $count === 1 ? '' : 's'));
        }
        exit(1);
    }
    if ($json) {
        fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    } else {
        try {
            fwrite(STDOUT, CarveConverter::carve()->render($codec->decode($result['ast'])));
        } catch (Throwable $exception) {
            fwrite(STDERR, 'carve merge: ' . $exception->getMessage() . "\n");
            exit(2);
        }
    }
    exit(0);
}

/**
 * @param array<int, string> $argv
 */
function runMigrateCommand(array $argv): never
{
    $mode = 'safe';
    $adapter = 'generic';
    $report = null;
    $checkLoss = false;
    $from = null;
    $input = null;
    for ($i = 2, $count = count($argv); $i < $count; $i++) {
        $arg = $argv[$i];
        if (in_array($arg, ['--from', '--mode', '--adapter', '--report'], true)) {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "carve migrate: $arg requires a value\n");
                exit(2);
            }
            $value = $argv[++$i];
            match ($arg) {
                '--from' => $from = $value,
                '--mode' => $mode = $value,
                '--adapter' => $adapter = $value,
                '--report' => $report = $value,
            };
        } elseif ($arg === '--check-loss') {
            $checkLoss = true;
        } elseif (str_starts_with($arg, '-') && $arg !== '-') {
            fwrite(STDERR, "carve migrate: unknown option: $arg\n");
            exit(2);
        } elseif ($input !== null) {
            fwrite(STDERR, "carve migrate: takes at most one input file\n");
            exit(2);
        } else {
            $input = $arg;
        }
    }
    if ($from === null) {
        fwrite(STDERR, "carve migrate: --from html, markdown, djot or bbcode is required\n");
        exit(2);
    }
    if (!in_array($from, ['html', 'markdown', 'md', 'djot', 'bbcode'], true)) {
        fwrite(STDERR, "carve migrate: unknown source format $from\n");
        exit(2);
    }
    $source = $input === null || $input === '-' ? stream_get_contents(STDIN) : @file_get_contents($input);
    if ($source === false) {
        fwrite(STDERR, "carve migrate: cannot read input\n");
        exit(2);
    }
    $source = (string)$source;
    // Only the HTML importer reports what it could not carry across, because
    // only it drops anything: the other three parse their source whole. So
    // --mode, --adapter, --report and --check-loss are HTML's alone, and are
    // silently unused here rather than rejected.
    if ($from !== 'html') {
        $converter = match ($from) {
            'markdown', 'md' => new MarkdownToCarve(),
            'djot' => new DjotToCarve(),
            default => new BbcodeToCarve(),
        };
        fwrite(STDOUT, $converter->convert($source));
        exit(0);
    }
    try {
        $result = (new HtmlToCarve(importMode: $mode, importAdapter: $adapter))->convertWithReport($source);
    } catch (InvalidArgumentException $exception) {
        fwrite(STDERR, 'carve migrate: ' . $exception->getMessage() . "\n");
        exit(2);
    }
    fwrite(STDOUT, $result->value);
    $json = json_encode($result->report(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
    if ($report === '-') {
        fwrite(STDERR, $json);
    } elseif ($report !== null && file_put_contents($report, $json) === false) {
        fwrite(STDERR, "carve migrate: cannot write report $report\n");
        exit(2);
    }
    exit($checkLoss && $result->diagnostics !== [] ? 1 : 0);
}

/**
 * Parse command line arguments
 *
 * @param array<int, string> $argv
 * @return array{options: array<string, bool|string>, input: ?string}
 */
function parseArgs(array $argv): array
{
    $options = [
        'smartTypography' => 'glyph',
        'output' => null,
        'format' => 'html',
        'fromJson' => false,
        'xhtml' => false,
        'safe' => false,
        'static' => false,
        'warnings' => false,
        'strict' => false,
        'strictLosses' => false,
        'reportLosses' => null,
        'allowLoss' => false,
        'maxRenderLosses' => 100,
        'help' => false,
        'version' => false,
    ];
    $input = null;

    $argc = count($argv);
    if (($argv[1] ?? null) === 'fmt') {
        return parseFmtArgs($argv);
    }
    if (($argv[1] ?? null) === 'lint') {
        return parseLintArgs($argv);
    }
    for ($i = 1; $i < $argc; $i++) {
        $arg = $argv[$i];

        if ($arg === '-h' || $arg === '--help') {
            $options['help'] = true;
        } elseif ($arg === '-v' || $arg === '--version') {
            $options['version'] = true;
        } elseif ($arg === '--html') {
            $options['format'] = 'html';
        } elseif ($arg === '--markdown' || $arg === '--md') {
            $options['format'] = 'markdown';
        } elseif ($arg === '--plain' || $arg === '--plain-text') {
            $options['format'] = 'plain';
        } elseif ($arg === '--ansi') {
            $options['format'] = 'ansi';
        } elseif ($arg === '--carve') {
            $options['format'] = 'carve';
        } elseif ($arg === '--json' || $arg === '--ast') {
            $options['format'] = 'json';
        } elseif ($arg === '--stamp-info') {
            $options['format'] = 'stamp-info';
        } elseif ($arg === '--stamp-check') {
            $options['format'] = 'stamp-check';
        } elseif ($arg === '--from-json') {
            $options['fromJson'] = true;
        } elseif ($arg === '-x' || $arg === '--xhtml') {
            $options['xhtml'] = true;
        } elseif ($arg === '-s' || $arg === '--safe') {
            $options['safe'] = true;
        } elseif ($arg === '--static') {
            $options['static'] = true;
        } elseif ($arg === '-w' || $arg === '--warnings') {
            $options['warnings'] = true;
        } elseif ($arg === '--strict') {
            $options['strict'] = true;
            $options['warnings'] = true;
        } elseif ($arg === '--strict-losses') {
            $options['strictLosses'] = true;
        } elseif ($arg === '--report-losses') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --report-losses requires a filename or -\n");
                exit(2);
            }
            $options['reportLosses'] = $argv[++$i];
        } elseif ($arg === '--allow-loss') {
            if (($argv[$i + 1] ?? null) !== 'raw-format-dropped') {
                fwrite(STDERR, "Error: --allow-loss expects raw-format-dropped\n");
                exit(2);
            }
            $i++;
            $options['allowLoss'] = true;
        } elseif ($arg === '--max-render-losses') {
            $value = $argv[$i + 1] ?? null;
            if ($value === null || !ctype_digit($value)) {
                fwrite(STDERR, "Error: --max-render-losses requires a non-negative integer\n");
                exit(2);
            }
            $i++;
            $options['maxRenderLosses'] = (int)$value;
        } elseif ($arg === '--smart-typography') {
            // The document-global switch the spec documents. Source mode is
            // for machine-facing output - text piped into something that
            // re-parses it - which is the shape of a CLI invocation.
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --smart-typography requires a mode (glyph|source)\n");
                exit(1);
            }
            $mode = $argv[++$i];
            if ($mode !== 'glyph' && $mode !== 'source') {
                fwrite(STDERR, "Error: Unknown smart typography mode: $mode (expected glyph|source)\n");
                exit(1);
            }
            $options['smartTypography'] = $mode;
        } elseif ($arg === '-o' || $arg === '--output') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --output requires a filename\n");
                exit(1);
            }
            $options['output'] = $argv[++$i];
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "Error: Unknown option: $arg\n");
            fwrite(STDERR, "Try 'carve --help' for more information.\n");
            exit(1);
        } else {
            if ($input !== null) {
                fwrite(STDERR, "Error: Multiple input files specified\n");
                exit(1);
            }
            $input = $arg;
        }
    }

    return ['options' => $options, 'input' => $input];
}

/**
 * @param array<int, string> $argv
 * @return array{options: array<string, bool|string|null|array<int, string>>, input: ?string}
 */
/**
 * @param list<string> $argv
 * @return array<string, mixed>
 */
function parseLintArgs(array $argv): array
{
    $options = ['command' => 'lint', 'help' => false, 'files' => [], 'platforms' => []];

    $argc = count($argv);
    for ($i = 2; $i < $argc; $i++) {
        $arg = $argv[$i];
        if ($arg === '-h' || $arg === '--help') {
            $options['help'] = true;
        } elseif ($arg === '--platform') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --platform requires a name\n");
                exit(1);
            }
            $platform = $argv[++$i];
            assertKnownLintPlatform($platform);
            $options['platforms'][] = $platform;
        } elseif (str_starts_with($arg, '--platform=')) {
            $platform = substr($arg, strlen('--platform='));
            assertKnownLintPlatform($platform);
            $options['platforms'][] = $platform;
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "Error: Unknown lint option: $arg\n");
            exit(1);
        } else {
            $options['files'][] = $arg;
        }
    }

    return ['options' => $options, 'input' => null];
}

/**
 * REFUSED here, while the programmatic API ignores an unknown name. The
 * asymmetry is deliberate: a misspelt flag that silently reported nothing would
 * be indistinguishable from a clean document, and an API caller has a type
 * checker where a command line has none.
 */
function assertKnownLintPlatform(string $platform): void
{
    $known = MarkdownHabitLinter::knownPlatforms();
    if (in_array($platform, $known, true)) {
        return;
    }

    fwrite(
        STDERR,
        sprintf(
            "Error: Unknown --platform value: %s (known: %s)\n",
            $platform,
            implode(', ', $known),
        ),
    );
    exit(1);
}

function parseFmtArgs(array $argv): array
{
    $files = [];
    $options = [
        'command' => 'fmt',
        'write' => false,
        'check' => false,
        'stamp' => false,
        'stampForm' => 'line',
        'help' => false,
        'files' => [],
    ];
    $argc = count($argv);
    for ($i = 2; $i < $argc; $i++) {
        $arg = $argv[$i];
        if ($arg === '-h' || $arg === '--help') {
            $options['help'] = true;
        } elseif ($arg === '-w' || $arg === '--write') {
            $options['write'] = true;
        } elseif ($arg === '--check') {
            $options['check'] = true;
        } elseif ($arg === '--stamp') {
            $options['stamp'] = true;
            $options['stampForm'] = 'line';
        } elseif ($arg === '--stamp-block') {
            $options['stamp'] = true;
            $options['stampForm'] = 'block';
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "Error: Unknown fmt option: $arg\n");
            exit(1);
        } else {
            $files[] = $arg;
        }
    }
    if ($options['write'] && $options['check']) {
        fwrite(STDERR, "Error: fmt --write and --check are mutually exclusive\n");
        exit(1);
    }
    $options['files'] = $files;

    return ['options' => $options, 'input' => null];
}

function showHelp(): void
{
    echo <<<'HELP'
Carve - Render Carve markup

Usage:
  carve fmt [options] [files...]
  carve merge [--json] base.crv ours.crv theirs.crv
  carve [options] [input-file]
  cat file.crv | carve [options]

Arguments:
  input-file          Input Carve file (reads from stdin if not specified)

Output format (default --html; last one wins):
  --html              HTML
  --markdown, --md    Markdown
  --plain, --plain-text  plain text
  --json, --ast          the parsed AST as JSON (see docs/ast-json.md)
  --stamp-info           report the document's provenance marker
  --stamp-check          exit 1 when the document predates this spec version
  --from-json            read an encoded AST instead of Carve source
  --ansi              ANSI-colored terminal text
  --carve             canonical Carve source

Rendering:
  --smart-typography MODE  glyph (default) or source: emit the runs the author
                           typed instead of the resolved glyphs (HTML/Markdown)
  --strict-losses          Refuse output when a raw format would be dropped
  --report-losses FILE     Write the machine-readable render-loss report (`-` for stderr)
  --allow-loss raw-format-dropped
                           Accept intentional target filtering
  --max-render-losses N    Bound detailed losses while retaining the full count (default 100)

Formatter:
  lint                Report markup that renders as something else: Markdown
                      habits, semantic span attributes that lose a value or sit
                      outside a span, and source written to a retired spelling
  lint --platform NAME
                      Also report host autolinks a platform re-linkifies
                      (repeatable; off unless named)
  fmt                 Format Carve source to stdout
  fmt -w, --write     Format files in place
  fmt --check         Exit non-zero if any file is not formatted
  fmt --stamp         Append/replace a one-line provenance marker
  fmt --stamp-block   Append/replace a block provenance marker

Migration (other markup to Carve, on stdout):
  migrate --from FORMAT   html, markdown (md), djot or bbcode
  migrate --mode MODE     HTML only: safe (default), semantic or roundtrip
                          (roundtrip is for trusted input only: it reads the
                          source back out of the sidecar attributes)
  migrate --adapter NAME  HTML only: the source generator (default generic)
  migrate --report FILE   HTML only: write the loss report as JSON (- is stderr)
  migrate --check-loss    HTML only: exit 1 when anything was dropped

Options:
  -o, --output FILE   Write output to FILE instead of stdout
  -x, --xhtml         Use XHTML-compatible output (self-closing tags; HTML only)
  -s, --safe          Enable safe mode (sanitize dangerous HTML; HTML only)
  --static            Render in static mode: flatten interactive constructs
                      (tabs / code-group to labeled sections, mermaid / math to
                      source) so the HTML needs no client scripts. HTML only;
                      the bundled interactive extensions are auto-registered for
                      the HTML format so the difference is visible.
  -w, --warnings      Show parse warnings on stderr
  --strict            Exit with error code 1 if warnings are generated
  -h, --help          Show this help message
  -v, --version       Show version information

Examples:
  carve document.crv                    Render file to stdout (HTML)
  carve --static document.crv           Render self-contained static HTML
  carve --ansi document.crv             Render colored terminal output
  carve --markdown document.crv         Render Markdown
  carve --carve document.crv            Render canonical Carve source
  carve fmt -w document.crv             Format file in place
  carve migrate --from djot notes.dj    Convert Djot to Carve on stdout
  carve document.crv -o document.html   Render to an output file
  echo '*hello*' | carve                Render from stdin

HELP;
}

function showVersion(): void
{
    echo 'carve-php version ' . CarveConverter::LIB_VERSION . "\n";
}

// Main
if (($argv[1] ?? null) === 'merge') {
    runMergeCommand($argv);
}
if (($argv[1] ?? null) === 'migrate') {
    runMigrateCommand($argv);
}
$parsed = parseArgs($argv);
$options = $parsed['options'];
$inputFile = $parsed['input'];

if (($options['command'] ?? null) === 'lint') {
    if ($options['help']) {
        showHelp();
        exit(0);
    }

    $linter = new MarkdownHabitLinter();
    $semanticLinter = new SemanticAttributeLinter();
    $retiredLinter = new RetiredSpellingLinter();
    $tableColumnLinter = new TableColumnLinter();
    $templateSourceLinter = new TemplateSourceLinter();
    $figureGroupLinter = new FigureGroupLinter();
    $quoteFenceLinter = new QuoteFenceLinter();
    $sources = [];

    if ($options['files'] === []) {
        $stdin = stream_get_contents(STDIN);
        if ($stdin === false) {
            fwrite(STDERR, "Error: Failed to read from stdin\n");
            exit(1);
        }
        $sources['-'] = $stdin;
    } else {
        foreach ($options['files'] as $file) {
            if (!is_file($file)) {
                fwrite(STDERR, "Error: File not found: $file\n");
                exit(1);
            }
            $sources[$file] = (string)file_get_contents($file);
        }
    }

    $found = 0;
    foreach ($sources as $name => $source) {
        // A CORE render, because that is what `carve` renders with unless the
        // caller builds a converter itself. The extension-aware reading is a
        // programmatic option rather than a flag: `carve` has no way to be told
        // which extensions the document will be published through.
        $warnings = array_merge(
            $linter->lint($source, ['platforms' => $options['platforms']]),
            $semanticLinter->lint($source),
            $retiredLinter->lint($source),
            $tableColumnLinter->lint($source),
            $templateSourceLinter->lint($source),
            $figureGroupLinter->lint($source),
            $quoteFenceLinter->lint($source),
        );
        usort(
            $warnings,
            static fn ($a, $b): int => [$a->line, $a->column] <=> [$b->line, $b->column],
        );
        foreach ($warnings as $warning) {
            $found++;
            fwrite(STDOUT, sprintf(
                "%s:%d:%d %s %s\n",
                $name,
                $warning->line,
                $warning->column,
                $warning->rule,
                $warning->message,
            ));
        }
    }

    exit($found === 0 ? 0 : 1);
}

if (($options['command'] ?? null) === 'fmt') {
    if ($options['help']) {
        showHelp();
        exit(0);
    }
    $files = $options['files'];
    $exitCode = 0;
    $generatedBy = 'carve-php ' . CarveConverter::LIB_VERSION;
    if ($files === []) {
        $input = stream_get_contents(STDIN);
        if ($input === false) {
            fwrite(STDERR, "Error: Failed to read from stdin\n");
            exit(1);
        }
        $formatted = CarveConverter::toCarve($input);
        if ($options['stamp']) {
            $formatted = CarveConverter::stampCarve($formatted, $generatedBy, $options['stampForm']);
        }
        echo $formatted;
        exit(0);
    }
    foreach ($files as $file) {
        if (!is_string($file) || !is_file($file) || !is_readable($file)) {
            fwrite(STDERR, "Error: Cannot read file: $file\n");
            $exitCode = 1;

            continue;
        }
        $input = file_get_contents($file);
        if ($input === false) {
            fwrite(STDERR, "Error: Failed to read file: $file\n");
            $exitCode = 1;

            continue;
        }
        $formatted = CarveConverter::toCarve($input);
        if ($options['stamp']) {
            $formatted = CarveConverter::stampCarve($formatted, $generatedBy, $options['stampForm']);
        }
        if ($options['check']) {
            if ($formatted !== $input) {
                fwrite(STDERR, "$file is not formatted\n");
                $exitCode = 1;
            }

            continue;
        }
        if ($options['write']) {
            if (file_put_contents($file, $formatted) === false) {
                fwrite(STDERR, "Error: Failed to write file: $file\n");
                $exitCode = 1;
            }

            continue;
        }
        echo $formatted;
    }
    exit($exitCode);
}

if ($options['help']) {
    showHelp();
    exit(0);
}

if ($options['version']) {
    showVersion();
    exit(0);
}

// Read input
if ($inputFile !== null) {
    if (!file_exists($inputFile)) {
        fwrite(STDERR, "Error: File not found: $inputFile\n");
        exit(1);
    }
    if (!is_readable($inputFile)) {
        fwrite(STDERR, "Error: Cannot read file: $inputFile\n");
        exit(1);
    }
    $input = file_get_contents($inputFile);
    if ($input === false) {
        fwrite(STDERR, "Error: Failed to read file: $inputFile\n");
        exit(1);
    }
} else {
    // Read from stdin
    if (posix_isatty(STDIN)) {
        fwrite(STDERR, "Reading from stdin... (Ctrl+D to end, Ctrl+C to cancel)\n");
    }
    $input = stream_get_contents(STDIN);
    if ($input === false) {
        fwrite(STDERR, "Error: Failed to read from stdin\n");
        exit(1);
    }
}

// The stamp modes answer a question about the document rather than rendering it,
// so they short-circuit before any converter exists.
if ($options['format'] === 'stamp-info' || $options['format'] === 'stamp-check') {
    $stamp = Stamp::read($input);
    $current = CarveConverter::SPEC_VERSION;

    if ($stamp === null) {
        fwrite(STDOUT, "unstamped (spec version unknown; this engine targets $current)\n");
    } else {
        fwrite(STDOUT, sprintf(
            "carve-version: %s\ngenerated-by: %s\nthis engine targets: %s\n",
            $stamp['version'],
            $stamp['generatedBy'] ?? '(unrecorded)',
            $current,
        ));
    }

    if ($options['format'] === 'stamp-check' && Stamp::needsReview($input, $current)) {
        fwrite(STDERR, "Review the [behavior] changelog entries between that version and $current.\n");

        exit(1);
    }

    exit(0);
}

// Create converter. The non-HTML renderers (Markdown / plain text / ANSI) are
// their own converters; the --xhtml / --safe options are HTML-only and ignored
// for those formats.
$wantWarnings = $options['warnings'] || $options['strict'];
// The non-HTML factories take a pre-configured parser; pass a warnings-enabled
// one so --warnings / --strict work for every format (getWarnings() reads the
// parser). --xhtml / --safe stay HTML-only.
// Enable warning COLLECTION but not the parser's throw-on-error strict mode:
// --strict is enforced by the CLI below (non-zero exit when warnings exist),
// matching the HTML path.
$converter = match ($options['format']) {
    // PART 12 §4 requires `pos` on every node but the root, so the AST output
    // asks the parser to record them. Tracking is opt-in because it costs work
    // on every parse, and this is the only format that publishes the result.
    'json' => new CarveConverter(parser: new BlockParser($wantWarnings, false, false, true)),
    'markdown' => CarveConverter::markdown(new BlockParser($wantWarnings)),
    'plain' => CarveConverter::plainText(new BlockParser($wantWarnings)),
    'ansi' => CarveConverter::ansi(new BlockParser($wantWarnings)),
    // Positions ON: the writer orders collected definitions by the spans §4
    // records, and they are opt-in (carve-php#905).
    'carve' => CarveConverter::carve(new BlockParser($wantWarnings, false, false, true)),
    default => new CarveConverter(
        xhtml: $options['xhtml'],
        warnings: $wantWarnings,
        safeMode: $options['safe'] ? true : null,
        mode: $options['static'] ? RenderMode::STATIC : RenderMode::INTERACTIVE,
    ),
};

// Smart typography is a RENDERING choice, so it is set on the renderer rather
// than on the parse. Every presentation target carries the mode: HTML,
// Markdown, plain text and ANSI. The last two used to emit the glyph whatever
// the flag said, so `--smart-typography source` was accepted and ignored there
// (carve#560).
if (($options['smartTypography'] ?? 'glyph') === 'source') {
    $renderer = $converter->getRenderer();
    if (
        $renderer instanceof HtmlRenderer
        || $renderer instanceof MarkdownRenderer
        || $renderer instanceof PlainTextRenderer
        || $renderer instanceof AnsiRenderer
    ) {
        $renderer->setSmartTypography(SmartTypographyMode::Source);
    }
}

// Register the bundled interactive extensions for the HTML format so a sample
// that uses tabs / code-group / math / mermaid renders meaningfully in both
// modes and the --static difference is observable. The non-HTML renderers
// flatten these constructs natively, so they need no extension wiring here.
if ($options['format'] === 'html') {
    $converter->addExtension(new TabsExtension());
    $converter->addExtension(new CodeGroupExtension());
    $converter->addExtension(new MathBlockExtension());
    $converter->addExtension(new DetailsExtension());
    $converter->addExtension(new SpoilerExtension());
    $converter->addExtension(FencedRenderExtension::mermaid());
}

// Convert. --from-json reads an encoded AST instead of Carve source, so the
// parse step is replaced by a decode; every format then renders as usual.
$codec = new AstCodec();
try {
    $document = $options['fromJson'] ? $codec->decodeJson($input) : null;
} catch (JsonException | RuntimeException $exception) {
    // A malformed tree is user input like any other: report it on stderr and
    // exit 1 rather than dumping a PHP stack trace.
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");

    exit(1);
}

try {
    if ($options['format'] === 'json') {
        $output = $codec->encodeJson(
            $document ?? $converter->parse($input),
            JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE,
        ) . "\n";
    } elseif ($document !== null) {
        $checked = $converter->renderWithReport($document, false, $options['maxRenderLosses']);
        $output = $checked->value;
    } else {
        $checked = $converter->convertWithReport($input, false, $options['maxRenderLosses']);
        $output = $checked->value;
    }
} catch (RenderDepthExceededException $exception) {
    // A renderer that reaches its ceiling REFUSES (PART 9 §25). The CLI reports
    // the refusal and exits non-zero rather than printing a partial document -
    // or a PHP stack trace, which tells the caller as little as truncation did.
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");

    exit(1);
}

// Handle warnings
$exitCode = 0;
$checked ??= new RenderResult($output, [], 0, false);
if ($options['allowLoss']) {
    $checked = new RenderResult($checked->value, [], 0, false);
}
if ($checked->totalLosses > 0) {
    foreach ($checked->losses as $loss) {
        $pos = isset($loss['pos']) ? ':' . $loss['pos']['startLine'] . ':' . $loss['pos']['startColumn'] : '';
        fwrite(STDERR, ($inputFile ?? '<stdin>') . $pos . ' ' . $loss['code'] . ' - ' . $loss['message'] . "\n");
    }
    fwrite(STDERR, sprintf("%s: %d render loss%s\n", $inputFile ?? '<stdin>', $checked->totalLosses, $checked->totalLosses === 1 ? '' : 'es'));
}
if ($options['reportLosses'] !== null) {
    $report = json_encode(['losses' => $checked->losses, 'totalLosses' => $checked->totalLosses, 'truncated' => $checked->truncated], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
    if ($options['reportLosses'] === '-') {
        fwrite(STDERR, $report);
    } elseif (file_put_contents($options['reportLosses'], $report) === false) {
        fwrite(STDERR, "Error: Failed to write render-loss report\n");
        exit(2);
    }
}
if ($options['strictLosses'] && $checked->totalLosses > 0) {
    exit(1);
}
if ($options['warnings'] || $options['strict']) {
    $warnings = $converter->getWarnings();
    foreach ($warnings as $warning) {
        fwrite(STDERR, "Warning: $warning\n");
    }
    if ($options['strict'] && count($warnings) > 0) {
        $exitCode = 1;
    }
}

// Write output
if ($options['output'] !== null) {
    $result = file_put_contents($options['output'], $output);
    if ($result === false) {
        fwrite(STDERR, "Error: Failed to write to: {$options['output']}\n");
        exit(1);
    }
} else {
    echo $output;
}

exit($exitCode);
