/**
 * Write rendered output, ending in exactly one newline.
 *
 * A document that renders to NOTHING still produces a line. carve-js and
 * carve-rs both do this - carve-rs spells the same rule as "append a newline
 * unless the output already ends with one" - and the difference is not
 * cosmetic: a tool that emits zero bytes leaves the next shell prompt glued to
 * the command, and `$(carve doc.crv)` compared against a fixture differed by a
 * byte depending on which engine produced it.
 *
 * The same bytes go to a file as to stdout: `-o` is a redirect, not a different
 * format.
 *
 * @param string $output
 * @param string|null $file
 * @return void
 */
function writeRendered(string $output, ?string $file): void
{
    if (!str_ends_with($output, "\n")) {
        $output .= "\n";
    }

    if ($file === null) {
        echo $output;

        return;
    }

    if (file_put_contents($file, $output) === false) {
        fwrite(STDERR, "Error: Failed to write to: {$file}\n");
        exit(1);
    }
}

/**
 * `carve flatten` - write the document back as ONE self-contained Carve file,
 * with every include expanded in place.
 *
 * The deliberate opposite of `carve fmt`, and the reason both exist. Formatting
 * round-trips the author's document, so it leaves directives alone (spec I15);
 * flattening asks for the OTHER document, the one with the children merged in,
 * because that is what can be handed to something with no filesystem behind it.
 *
 * Two effects beyond inlining, both reported on stderr rather than left to be
 * discovered in a published page: the output is CANONICAL Carve, so formatting
 * is normalized rather than preserved, and colliding heading ids and footnote
 * labels are renamed (I5). The renames are written into the source, so the
 * flattened file renders exactly like the expanded original.
 *
 * @param array<int, string> $argv
 */
/**
 * A user-supplied `--include-root` expanded against the working directory.
 *
 * An unreadable spec is handed on unchanged so the resolver reports it as the
 * missing root it is, rather than this turning it into a relative-root refusal.
 */
function absoluteIncludeRoot(string $spec): string
{
    return realpath($spec) ?: $spec;
}

function runFlattenCommand(array $argv): never
{
    $includeRoot = null;
    $input = null;
    $argc = count($argv);
    for ($i = 2; $i < $argc; $i++) {
        $arg = $argv[$i];
        if ($arg === '--include-root') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --include-root requires a directory\n");
                exit(1);
            }
            // The spec constrains the ROOT, not what a front end computes: a
            // non-absolute spec is refused by the resolver, so `--include-root .`
            // is expanded HERE, in argument parsing, where the working directory
            // is the user's own choice rather than an accident of the library.
            $includeRoot = absoluteIncludeRoot($argv[++$i]);
        } elseif ($arg === '-h' || $arg === '--help') {
            showHelp();
            exit(0);
        } elseif (str_starts_with($arg, '-') && $arg !== '-') {
            fwrite(STDERR, "Error: Unknown option: $arg\n");
            exit(1);
        } elseif ($input !== null) {
            fwrite(STDERR, "Error: Multiple input files specified\n");
            exit(1);
        } else {
            $input = $arg;
        }
    }

    if ($input !== null && $input !== '-') {
        if (!is_readable($input)) {
            fwrite(STDERR, "Error: Cannot read file: $input\n");
            exit(1);
        }
        $source = (string)file_get_contents($input);
        $sourcePath = realpath($input) ?: $input;
    } else {
        $source = (string)stream_get_contents(STDIN);
        $sourcePath = null;
    }

    $root = $includeRoot ?? ($sourcePath === null ? null : dirname($sourcePath));
    if ($root === null) {
        // "Flatten this" with nothing to resolve against cannot be honoured,
        // and echoing the document back would look like it had no includes.
        fwrite(
            STDERR,
            "Error: stdin has no directory to resolve includes against; pass --include-root DIR\n",
        );
        exit(1);
    }

    try {
        $resolver = new FilesystemIncludeResolver($root);
    } catch (RuntimeException $exception) {
        fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");
        exit(1);
    }

    // POSITIONS ON, via the writer's own factory: the expander collects a
    // merged child's footnote definitions by their file identity (`pos.file`),
    // and the writer orders collected definitions by the spans positions carry.
    // Parsed without them, every merged definition reported no span, so they
    // stayed interleaved between the parent's blocks where the child had them.
    $converter = CarveConverter::carve();
    $expander = new IncludeExpander(resolver: $resolver, currentPath: $sourcePath);
    $document = $converter->transform($converter->parse($source), $expander);

    foreach ($expander->getWarnings() as $warning) {
        fwrite(STDERR, 'carve: ' . $warning->getMessage() . ' [' . ($warning->getRule() ?? 'include') . "]\n");
    }
    $suppressed = $expander->getSuppressedWarnings();
    if ($suppressed > 0) {
        fwrite(STDERR, "carve: $suppressed further include warning(s) suppressed\n");
    }

    echo $converter->render($document);
    exit(0);
}

/**
 * @param array<int, string> $argv
 */
function runMergeCommand(array $argv): never
{
    $json = false;
    $files = [];
    foreach (array_slice($argv, 2) as $arg) {
        if ($arg === '--json') {
            $json = true;
        } elseif ($arg === '-h' || $arg === '--help') {
            fwrite(STDOUT, "Usage: carve merge [--json] base ours theirs\n");
            exit(0);
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "carve merge: unknown option: $arg\n");
            exit(2);
        } else {
            $files[] = $arg;
        }
    }
    if (count($files) !== 3) {
        fwrite(STDERR, "carve merge: takes exactly three files (base, ours, theirs)\n");
        exit(2);
    }
    $codec = new AstCodec();
    $converter = new CarveConverter(parser: new BlockParser(false, false, false, true));
    $trees = [];
    foreach ($files as $file) {
        if (!is_file($file) || !is_readable($file)) {
            fwrite(STDERR, "carve merge: cannot read $file\n");
            exit(2);
        }
        $source = file_get_contents($file);
        if ($source === false) {
            fwrite(STDERR, "carve merge: cannot read $file\n");
            exit(2);
        }
        $trees[] = $codec->encode($converter->parse($source));
    }
    $result = AstMerge::merge($trees[0], $trees[1], $trees[2]);
    if (!$result['ok']) {
        if ($json) {
            fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
        } else {
            foreach ($result['conflicts'] as $conflict) {
                fwrite(STDERR, sprintf("conflict %s at %s\n", $conflict['reason'], $conflict['path']));
            }
            $count = count($result['conflicts']);
            fwrite(STDERR, sprintf("%d structural conflict%s\n", $count, $count === 1 ? '' : 's'));
        }
        exit(1);
    }
    if ($json) {
        fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    } else {
        try {
            fwrite(STDOUT, CarveConverter::carve()->render($codec->decode($result['ast'])));
        } catch (Throwable $exception) {
            fwrite(STDERR, 'carve merge: ' . $exception->getMessage() . "\n");
            exit(2);
        }
    }
    exit(0);
}

/**
 * Resolve an output path through its deepest existing ancestor.
 *
 * @throws \RuntimeException
 */
function resolveFutureOutputPath(string $path): string
{
    $ancestor = str_starts_with($path, DIRECTORY_SEPARATOR) ? $path : getcwd() . DIRECTORY_SEPARATOR . $path;
    $missing = [];
    while (!file_exists($ancestor) && !is_link($ancestor)) {
        $parent = dirname($ancestor);
        if ($parent === $ancestor) {
            throw new RuntimeException("cannot resolve output path: $path");
        }
        $name = basename($ancestor);
        if ($name === '.' || $name === '..') {
            throw new RuntimeException("output path traverses a missing directory: $path");
        }
        array_unshift($missing, $name);
        $ancestor = $parent;
    }
    $resolved = realpath($ancestor);
    if ($resolved === false) {
        throw new RuntimeException("cannot resolve output path: $path");
    }

    return $resolved . ($missing ? DIRECTORY_SEPARATOR . implode(DIRECTORY_SEPARATOR, $missing) : '');
}

/**
 * Open a migration entry, refusing one that is no longer the regular file the walk saw.
 *
 * @param string $input
 * @param string $path
 * @param array{0:int, 1:int}|null $identity
 * @return array{0:resource, 1:int}
 * @throws \RuntimeException
 */
function openMigrationEntry(string $input, string $path, ?array $identity): array
{
    clearstatcache(true, $input);
    $before = @lstat($input);
    if ($before === false) {
        throw new RuntimeException("cannot read $path");
    }
    if (($before['mode'] & 0170000) !== 0100000 || $identity !== [$before['dev'], $before['ino']]) {
        throw new RuntimeException("changed during migration: $path");
    }
    $handle = @fopen($input, 'rb');
    if ($handle === false) {
        throw new RuntimeException("cannot read $path");
    }
    $opened = fstat($handle);
    if ($opened === false || $identity !== [$opened['dev'], $opened['ino']]) {
        fclose($handle);

        throw new RuntimeException("changed during migration: $path");
    }

    return [$handle, $opened['mode'] & 0777];
}

/**
 * Convert a Markdown directory and return the migration counts.
 *
 * @return array{files:int, assets:int, review:int, skipped:int, report:string}
 * @throws \RuntimeException
 */
function migrateMarkdownDirectory(string $source, string $output): array
{
    $root = realpath($source);
    if ($root === false || !is_dir($root)) {
        throw new RuntimeException("source is not a directory: $source");
    }
    $final = resolveFutureOutputPath($output);
    if (file_exists($final) || is_link($final)) {
        throw new RuntimeException("output already exists: $final");
    }
    if ($final === $root || str_starts_with($final, $root . DIRECTORY_SEPARATOR)) {
        throw new RuntimeException('output must be outside the source directory');
    }
    $entries = [];
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $entry) {
        $path = str_replace(DIRECTORY_SEPARATOR, '/', substr($entry->getPathname(), strlen($root) + 1));
        $kind = $entry->isLink() || !$entry->isFile() ? 'skipped' : (preg_match('/\.(md|markdown)$/i', $entry->getFilename()) ? 'markdown' : 'asset');
        $status = $kind === 'skipped' ? false : lstat($entry->getPathname());
        $entries[] = ['path' => $path, 'kind' => $kind, 'identity' => $status === false ? null : [$status['dev'], $status['ino']]];
    }
    usort($entries, static fn (array $left, array $right): int => strcmp($left['path'], $right['path']));
    if (!in_array('markdown', array_column($entries, 'kind'), true)) {
        throw new RuntimeException('source contains no Markdown files');
    }
    $parent = dirname($final);
    if (!is_dir($parent) && !mkdir($parent, 0777, true)) {
        throw new RuntimeException("cannot create output parent: $parent");
    }
    // Staging sits in a private shell so other users cannot read it mid-run.
    $shell = $parent . DIRECTORY_SEPARATOR . '.' . basename($final) . '-' . bin2hex(random_bytes(8));
    if (!mkdir($shell, 0700)) {
        throw new RuntimeException("cannot create temporary directory: $shell");
    }
    $temporary = $shell . DIRECTORY_SEPARATOR . 'out';
    if (!mkdir($temporary)) {
        rmdir($shell);

        throw new RuntimeException("cannot create temporary directory: $temporary");
    }
    $fileMode = 0666 & ~umask();
    $files = [];
    $assets = [];
    $skipped = [];
    $review = [];
    $destinations = ['migration-report.json' => true];
    try {
        foreach ($entries as $entry) {
            $path = $entry['path'];
            $kind = $entry['kind'];
            if ($kind === 'skipped') {
                $skipped[] = $path;

                continue;
            }
            $destination = $kind === 'markdown' ? preg_replace('/\.(md|markdown)$/i', '.crv', $path) : $path;
            if ($destination === null) {
                throw new RuntimeException("invalid output path: $path");
            }
            if (!function_exists('mb_strtolower') && preg_match('/[^\x00-\x7F]/', $destination) === 1) {
                throw new RuntimeException('non-ASCII output names require mbstring');
            }
            $key = function_exists('mb_strtolower') ? mb_strtolower($destination, 'UTF-8') : strtolower($destination);
            if (isset($destinations[$key])) {
                throw new RuntimeException("two inputs map to the same output: $destination");
            }
            $destinations[$key] = true;
            $target = $temporary . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $destination);
            if (!is_dir(dirname($target)) && !mkdir(dirname($target), 0777, true)) {
                throw new RuntimeException("cannot create directory for $destination");
            }
            $input = $root . DIRECTORY_SEPARATOR . str_replace('/', DIRECTORY_SEPARATOR, $path);
            [$handle, $sourceMode] = openMigrationEntry($input, $path, $entry['identity']);
            try {
                if ($kind === 'asset') {
                    $written = file_put_contents($target, $handle);
                } else {
                    $sourceText = stream_get_contents($handle);
                }
            } finally {
                fclose($handle);
            }
            if ($kind === 'asset') {
                if ($written === false || !chmod($target, $sourceMode)) {
                    throw new RuntimeException("cannot copy $path");
                }
                $assets[] = $path;

                continue;
            }
            if ($sourceText === false) {
                throw new RuntimeException("cannot read $path");
            }
            // Ill-formed bytes are replaced, as single-file migration does (CARVE-P0-023).
            $result = (new MarkdownToCarve())->convertWithFidelityReport($sourceText);
            if (file_put_contents($target, $result->value) === false || !chmod($target, $fileMode & $sourceMode)) {
                throw new RuntimeException("cannot write $destination");
            }
            $diagnostics = $result->report()['diagnostics'];
            foreach ($diagnostics as $diagnostic) {
                if (in_array($diagnostic['fidelity'], ['degraded', 'dropped'], true)) {
                    $review[] = $path;

                    break;
                }
            }
            $files[] = ['source' => $path, 'output' => $destination, 'diagnostics' => $diagnostics];
        }
        $broken = checkMigratedLinks($temporary, $files, $assets);
        foreach ($broken as $path) {
            if (!in_array($path, $review, true)) {
                $review[] = $path;
            }
        }
        sort($review, SORT_STRING);
        $report = ['schemaVersion' => 1, 'sourceFormat' => 'markdown', 'files' => $files, 'assets' => $assets, 'skipped' => $skipped, 'review' => $review];
        if (file_put_contents($temporary . '/migration-report.json', json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n") === false) {
            throw new RuntimeException('cannot write migration report');
        }
        // POSIX rename() silently replaces an empty directory created after the
        // existence check, so claim the output first. Windows rename() refuses
        // any existing target, which also makes a claimed one unusable there.
        $claimed = PHP_OS_FAMILY !== 'Windows';
        if ($claimed && !@mkdir($final)) {
            throw new RuntimeException("output appeared during conversion: $final");
        }
        if (!@rename($temporary, $final)) {
            if ($claimed) {
                rmdir($final);
            }

            throw new RuntimeException("cannot create output: $final");
        }
        rmdir($shell);
    } catch (Throwable $exception) {
        $cleanup = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($shell, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::CHILD_FIRST);
        foreach ($cleanup as $entry) {
            $entry->isDir() && !$entry->isLink() ? rmdir($entry->getPathname()) : unlink($entry->getPathname());
        }
        rmdir($shell);

        throw $exception;
    }

    return ['files' => count($files), 'assets' => count($assets), 'review' => count($review), 'skipped' => count($skipped), 'report' => $final . '/migration-report.json'];
}

/**
 * Inspect a local link in a converted document.
 *
 * @return array{href:string, check:array<string,string>}|null
 */
function inspectMigratedLink(string $destination, string $source, array $outputs, array $ids): ?array
{
    if (preg_match('~^[a-z][a-z0-9+.-]*:|^//~i', $destination) === 1) {
        return null;
    }
    $failure = static fn (string $reason): array => ['href' => $destination, 'check' => ['target' => $destination, 'status' => 'unresolved', 'reason' => $reason]];
    if (str_starts_with($destination, '/')) {
        return $failure('site-root path needs route mapping');
    }
    $fragmentOffset = strpos($destination, '#');
    $beforeFragment = $fragmentOffset === false ? $destination : substr($destination, 0, $fragmentOffset);
    $rawFragment = $fragmentOffset === false ? null : substr($destination, $fragmentOffset + 1);
    $queryOffset = strpos($beforeFragment, '?');
    $rawPath = $queryOffset === false ? $beforeFragment : substr($beforeFragment, 0, $queryOffset);
    $query = $queryOffset === false ? '' : substr($beforeFragment, $queryOffset);
    if (preg_match('/%(?![0-9a-f]{2})/i', $rawPath . ($rawFragment ?? '')) === 1) {
        return $failure('invalid URL encoding');
    }
    $path = rawurldecode($rawPath);
    $fragment = rawurldecode($rawFragment ?? '');
    if (preg_match('//u', $path . $fragment) !== 1) {
        return $failure('invalid URL encoding');
    }
    $parts = explode('/', dirname($source));
    if ($parts === ['.']) {
        $parts = [];
    }
    if ($path !== '') {
        foreach (explode('/', $path) as $part) {
            if ($part === '' || $part === '.') {
                continue;
            }
            if ($part === '..') {
                if ($parts === []) {
                    return $failure('outside source directory');
                }
                array_pop($parts);
            } else {
                $parts[] = $part;
            }
        }
        $target = implode('/', $parts);
    } else {
        $target = $source;
    }
    $mapped = preg_replace('/\.(md|markdown)$/i', '.crv', $target);
    if ($mapped === null || !isset($outputs[$mapped])) {
        return $failure('target missing from output');
    }
    if ($fragment !== '' && !isset($ids[$mapped])) {
        return $failure('asset fragment needs site check');
    }
    if ($fragment !== '' && !isset($ids[$mapped][$fragment])) {
        return $failure('fragment missing from target');
    }
    if ($mapped !== $target && $path !== '' && preg_match('/\.(md|markdown)$/i', $rawPath) !== 1) {
        return $failure('encoded extension needs manual rewrite');
    }
    $newPath = $mapped !== $target && $path !== '' ? preg_replace('/\.(md|markdown)$/i', '.crv', $rawPath) : $rawPath;
    $href = $newPath . $query . ($rawFragment === null ? '' : '#' . $rawFragment);

    return ['href' => $href, 'check' => ['target' => $destination, 'status' => $href === $destination ? 'valid' : 'rewritten']];
}

/**
 * Read URLs from a responsive image candidate list.
 *
 * @return array<string>
 */
function normalizeRawHtmlUrl(string $value): string
{
    return str_replace(["\t", "\n", "\r"], '', trim($value, "\x00..\x20"));
}

function rawHtmlSrcsetUrls(string $value): array
{
    $urls = [];
    $index = 0;
    $length = strlen($value);
    $space = static fn (string $char): bool => in_array($char, [' ', "\t", "\n", "\r", "\f"], true);
    while ($index < $length) {
        while ($index < $length && ($space($value[$index]) || $value[$index] === ',')) {
            $index++;
        }
        $start = $index;
        while ($index < $length && !$space($value[$index])) {
            $index++;
        }
        $raw = substr($value, $start, $index - $start);
        $url = rtrim($raw, ',');
        if ($url !== '') {
            $urls[] = normalizeRawHtmlUrl($url);
        }
        if (str_ends_with($raw, ',')) {
            continue;
        }
        $inParentheses = false;
        while ($index < $length) {
            $char = $value[$index++];
            if ($char === '(') {
                $inParentheses = true;
            } elseif ($char === ')') {
                $inParentheses = false;
            } elseif ($char === ',' && !$inParentheses) {
                break;
            }
        }
    }

    return $urls;
}

/**
 * Read link destinations from HTML elements in a raw Carve node.
 *
 * @return array<array{target:string, manual:bool}>
 */
function rawHtmlUrls(string $html): array
{
    $document = new DOMDocument();
    $previous = libxml_use_internal_errors(true);
    try {
        $document->loadHTML('<?xml encoding="UTF-8"><body>' . $html, LIBXML_NONET);
    } finally {
        libxml_clear_errors();
        libxml_use_internal_errors($previous);
    }
    $urls = [];
    $nodes = (new DOMXPath($document))->query('//*[@href or @src or @srcset or @imagesrcset or @poster or @data or @action or @formaction][not(ancestor::template)]');
    foreach ($nodes ?: [] as $element) {
        if (!$element instanceof DOMElement) {
            continue;
        }
        foreach (['href', 'src', 'poster', 'data', 'action', 'formaction', 'srcset', 'imagesrcset'] as $attribute) {
            if ($attribute === 'data' && $element->localName !== 'object' || $attribute === 'action' && $element->localName !== 'form' || $attribute === 'formaction' && !in_array($element->localName, ['button', 'input'], true)) {
                continue;
            }
            if ($element->hasAttribute($attribute)) {
                $value = $element->getAttribute($attribute);
                if (in_array($attribute, ['srcset', 'imagesrcset'], true)) {
                    if (stripos($value, 'data:') !== false) {
                        $urls[] = ['target' => $value, 'manual' => true];
                    } else {
                        foreach (rawHtmlSrcsetUrls($value) as $target) {
                            $urls[] = ['target' => $target, 'manual' => false];
                        }
                    }
                } else {
                    $urls[] = ['target' => normalizeRawHtmlUrl($value), 'manual' => false];
                }
            }
        }
    }

    return $urls;
}

/**
 * Check link nodes in an AST record.
 *
 * @param array<string, mixed> $node
 * @param string $source
 * @param array<string, bool> $outputs
 * @param array<string, array<string, bool>> $ids
 * @param array<array<string, string>> $links
 * @param bool $changed
 */
function checkMigratedNode(array &$node, string $source, array $outputs, array $ids, array &$links, bool &$changed): void
{
    if (in_array($node['type'] ?? null, ['raw_inline', 'raw_block'], true) && ($node['format'] ?? null) === 'html' && isset($node['content']) && is_string($node['content'])) {
        foreach (rawHtmlUrls($node['content']) as $url) {
            $destination = $url['target'];
            if ($url['manual']) {
                $links[] = ['target' => $destination, 'status' => 'unresolved', 'reason' => 'raw HTML srcset needs manual review'];

                continue;
            }
            $result = inspectMigratedLink($destination, $source, $outputs, $ids);
            if ($result !== null) {
                $links[] = $result['check']['status'] === 'rewritten'
                    ? ['target' => $destination, 'status' => 'unresolved', 'reason' => 'raw HTML link needs manual rewrite']
                    : $result['check'];
            }
        }
    }
    $key = match ($node['type'] ?? null) {
        'link' => 'href',
        'image' => 'src',
        default => null,
    };
    if ($key !== null && isset($node[$key]) && is_string($node[$key]) && $node[$key] !== '') {
        $result = inspectMigratedLink($node[$key], $source, $outputs, $ids);
        if ($result !== null) {
            if ($result['href'] !== $node[$key] && isset($node['ref'])) {
                $links[] = ['target' => $node[$key], 'status' => 'unresolved', 'reason' => 'reference link needs manual rewrite'];
            } else {
                $links[] = $result['check'];
                if ($result['href'] !== $node[$key]) {
                    $node[$key] = $result['href'];
                    $changed = true;
                }
            }
        }
    }
    foreach ($node as $field => &$child) {
        if ($field === 'attrs' || $field === 'position' || !is_array($child)) {
            continue;
        }
        if (array_is_list($child)) {
            foreach ($child as &$item) {
                if (is_array($item)) {
                    checkMigratedNode($item, $source, $outputs, $ids, $links, $changed);
                }
            }
            unset($item);
        } else {
            checkMigratedNode($child, $source, $outputs, $ids, $links, $changed);
        }
    }
    unset($child);
}

/**
 * Check links in all converted files and rewrite verified Markdown targets.
 *
 * @param string $temporary
 * @param array<array<string, mixed>> $files
 * @param array<string> $assets
 * @return array<string>
 * @throws \RuntimeException
 */
function checkMigratedLinks(string $temporary, array &$files, array $assets): array
{
    $outputs = array_fill_keys(array_merge(array_column($files, 'output'), $assets), true);
    $ids = [];
    $htmlConverter = CarveConverter::create();
    foreach ($files as $file) {
        $text = file_get_contents($temporary . '/' . $file['output']);
        if ($text === false) {
            throw new RuntimeException('cannot read converted output');
        }
        $document = new DOMDocument();
        $previous = libxml_use_internal_errors(true);
        try {
            $document->loadHTML('<?xml encoding="UTF-8"><body>' . $htmlConverter->convert($text), LIBXML_NONET);
        } finally {
            libxml_clear_errors();
            libxml_use_internal_errors($previous);
        }
        $found = [];
        $nodes = (new DOMXPath($document))->query('//*[@id][not(ancestor::template)] | //a[@name][not(ancestor::template)]');
        foreach ($nodes ?: [] as $element) {
            if ($element instanceof DOMElement) {
                if ($element->hasAttribute('id')) {
                    $found[] = $element->getAttribute('id');
                }
                if ($element->localName === 'a' && $element->hasAttribute('name')) {
                    $found[] = $element->getAttribute('name');
                }
            }
        }
        $ids[$file['output']] = array_fill_keys($found, true);
    }
    $codec = new AstCodec();
    $writer = CarveConverter::carve();
    $broken = [];
    foreach ($files as &$file) {
        $path = $temporary . '/' . $file['output'];
        $text = file_get_contents($path);
        if ($text === false) {
            throw new RuntimeException('cannot read converted output');
        }
        $document = $codec->encode($htmlConverter->parse($text));
        $links = [];
        $changed = false;
        checkMigratedNode($document, $file['source'], $outputs, $ids, $links, $changed);
        $file['links'] = $links;
        foreach ($links as $link) {
            if ($link['status'] === 'unresolved') {
                $broken[] = $file['source'];

                break;
            }
        }
        if ($changed) {
            // The output already carries its source's mode, which may be read-only.
            $mode = fileperms($path) & 0777;
            if (!chmod($path, $mode | 0200) || file_put_contents($path, $writer->getRenderer()->render($codec->decode($document))) === false || !chmod($path, $mode)) {
                throw new RuntimeException('cannot write converted output');
            }
        }
    }
    unset($file);

    return $broken;
}

/**
 * @param array<int, string> $argv
 */
function runMigrateCommand(array $argv): never
{
    $mode = 'safe';
    $adapter = 'generic';
    $modeSet = false;
    $adapterSet = false;
    $report = null;
    $checkLoss = false;
    $listTable = false;
    $from = null;
    $input = null;
    $directory = null;
    $output = null;
    for ($i = 2, $count = count($argv); $i < $count; $i++) {
        $arg = $argv[$i];
        if (in_array($arg, ['--from', '--mode', '--adapter', '--report', '--directory', '--output'], true)) {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "carve migrate: $arg requires a value\n");
                exit(2);
            }
            $value = $argv[++$i];
            if ($arg === '--mode') {
                $modeSet = true;
            }
            if ($arg === '--adapter') {
                $adapterSet = true;
            }
            match ($arg) {
                '--from' => $from = $value,
                '--mode' => $mode = $value,
                '--adapter' => $adapter = $value,
                '--report' => $report = $value,
                '--directory' => $directory = $value,
                '--output' => $output = $value,
            };
        } elseif ($arg === '--check-loss') {
            $checkLoss = true;
        } elseif ($arg === '--list-table') {
            $listTable = true;
        } elseif (str_starts_with($arg, '-') && $arg !== '-') {
            fwrite(STDERR, "carve migrate: unknown option: $arg\n");
            exit(2);
        } elseif ($input !== null) {
            fwrite(STDERR, "carve migrate: takes at most one input file\n");
            exit(2);
        } else {
            $input = $arg;
        }
    }
    if ($from === null) {
        fwrite(STDERR, "carve migrate: --from html, markdown, djot or bbcode is required\n");
        exit(2);
    }
    if (!in_array($from, ['html', 'markdown', 'md', 'djot', 'bbcode'], true)) {
        fwrite(STDERR, "carve migrate: unknown source format $from\n");
        exit(2);
    }
    if ($directory !== null || $output !== null) {
        if (!in_array($from, ['markdown', 'md'], true) || $directory === null || $output === null || $input !== null || $report !== null || $listTable || $modeSet || $adapterSet) {
            fwrite(STDERR, "carve migrate: folder mode requires --from markdown --directory SOURCE --output TARGET; single-file options are not allowed\n");
            exit(2);
        }
        try {
            $counts = migrateMarkdownDirectory($directory, $output);
            fwrite(STDOUT, "{$counts['files']} file(s) converted; {$counts['assets']} asset(s) copied; {$counts['review']} file(s) need review; {$counts['skipped']} entry(s) skipped. Report: {$counts['report']}\n");
            exit($checkLoss && ($counts['review'] > 0 || $counts['skipped'] > 0) ? 1 : 0);
        } catch (Throwable $exception) {
            fwrite(STDERR, 'carve migrate: ' . $exception->getMessage() . "\n");
            exit(2);
        }
    }
    $source = $input === null || $input === '-' ? stream_get_contents(STDIN) : @file_get_contents($input);
    if ($source === false) {
        fwrite(STDERR, "carve migrate: cannot read input\n");
        exit(2);
    }
    $source = (string)$source;
    try {
        if ($from === 'html') {
            $result = (new HtmlToCarve(listTableForBlockCells: $listTable, importMode: $mode, importAdapter: $adapter))
                ->convertWithFidelityReport($source);
        } else {
            $converter = match ($from) {
                'markdown', 'md' => new MarkdownToCarve(),
                'djot' => new DjotToCarve(),
                default => new BbcodeToCarve(),
            };
            $result = $converter->convertWithFidelityReport($source);
        }
    } catch (Throwable $exception) {
        fwrite(STDERR, 'carve migrate: ' . $exception->getMessage() . "\n");
        exit(2);
    }
    fwrite(STDOUT, $result->value);
    $json = json_encode($result->report(), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
    if ($report === '-') {
        fwrite(STDERR, $json);
    } elseif ($report !== null && file_put_contents($report, $json) === false) {
        fwrite(STDERR, "carve migrate: cannot write report $report\n");
        exit(2);
    }
    $hasLoss = false;
    foreach ($result->diagnostics as $diagnostic) {
        if (in_array($diagnostic->fidelity, ['degraded', 'dropped'], true)) {
            $hasLoss = true;

            break;
        }
    }
    exit($checkLoss && $hasLoss ? 1 : 0);
}

/**
 * Parse command line arguments
 *
 * @param array<int, string> $argv
 * @return array{options: array<string, bool|string>, input: ?string}
 */
function parseArgs(array $argv): array
{
    $options = [
        'smartTypography' => 'glyph',
        'output' => null,
        'format' => 'html',
        'fromJson' => false,
        'xhtml' => false,
        'safe' => false,
        'static' => false,
        'warnings' => false,
        'strict' => false,
        'strictLosses' => false,
        'reportLosses' => null,
        'reportConversionDiagnostics' => null,
        'maxConversionDiagnostics' => 100,
        'allowLoss' => [],
        'maxRenderLosses' => 100,
        'includeRoot' => null,
        'noIncludes' => false,
        'roundTripMode' => false,
        'help' => false,
        'version' => false,
    ];
    $input = null;

    $argc = count($argv);
    if (($argv[1] ?? null) === 'fmt') {
        return parseFmtArgs($argv);
    }
    if (($argv[1] ?? null) === 'lint') {
        return parseLintArgs($argv);
    }
    for ($i = 1; $i < $argc; $i++) {
        $arg = $argv[$i];

        if ($arg === '-h' || $arg === '--help') {
            $options['help'] = true;
        } elseif ($arg === '-V' || $arg === '--version') {
            $options['version'] = true;
        } elseif ($arg === '--html') {
            $options['format'] = 'html';
        } elseif ($arg === '--markdown' || $arg === '--md') {
            $options['format'] = 'markdown';
        } elseif ($arg === '--plain' || $arg === '--plain-text') {
            $options['format'] = 'plain';
        } elseif ($arg === '--ansi') {
            $options['format'] = 'ansi';
        } elseif ($arg === '--carve') {
            $options['format'] = 'carve';
        } elseif ($arg === '--json' || $arg === '--ast') {
            $options['format'] = 'json';
        } elseif ($arg === '--stamp-info') {
            $options['format'] = 'stamp-info';
        } elseif ($arg === '--stamp-check') {
            $options['format'] = 'stamp-check';
        } elseif ($arg === '--from-json') {
            $options['fromJson'] = true;
        } elseif ($arg === '-x' || $arg === '--xhtml') {
            $options['xhtml'] = true;
        } elseif ($arg === '-s' || $arg === '--safe') {
            $options['safe'] = true;
            $options['noIncludes'] = true;
        } elseif ($arg === '--no-includes') {
            $options['noIncludes'] = true;
        } elseif ($arg === '--static') {
            $options['static'] = true;
        } elseif ($arg === '-w' || $arg === '--warnings') {
            $options['warnings'] = true;
        } elseif ($arg === '--strict') {
            $options['strict'] = true;
            $options['warnings'] = true;
        } elseif ($arg === '--strict-losses') {
            $options['strictLosses'] = true;
        } elseif ($arg === '--report-losses') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --report-losses requires a filename or -\n");
                exit(2);
            }
            $options['reportLosses'] = $argv[++$i];
        } elseif ($arg === '--report-conversion-diagnostics') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --report-conversion-diagnostics requires a filename or -\n");
                exit(2);
            }
            $options['reportConversionDiagnostics'] = $argv[++$i];
        } elseif ($arg === '--max-conversion-diagnostics') {
            $value = $argv[$i + 1] ?? null;
            if ($value === null || !ctype_digit($value)) {
                fwrite(STDERR, "Error: --max-conversion-diagnostics requires a non-negative integer\n");
                exit(2);
            }
            $options['maxConversionDiagnostics'] = (int)$argv[++$i];
        } elseif ($arg === '--allow-loss') {
            if (!in_array(($argv[$i + 1] ?? null), ['raw-format-dropped', 'ruby-flattened', 'editorial-comment-flattened', 'carrier-attribute-dropped', 'list-style-dropped', 'list-delimiter-changed', 'table-span-flattened', 'table-header-row-demoted', 'table-header-row-hoisted', 'table-header-cell-demoted'], true)) {
                fwrite(STDERR, "Error: --allow-loss expects raw-format-dropped, ruby-flattened, editorial-comment-flattened, carrier-attribute-dropped, list-style-dropped, list-delimiter-changed, table-span-flattened, table-header-row-demoted, table-header-row-hoisted or table-header-cell-demoted\n");
                exit(2);
            }
            $options['allowLoss'][] = $argv[++$i];
        } elseif ($arg === '--max-render-losses') {
            $value = $argv[$i + 1] ?? null;
            if ($value === null || !ctype_digit($value)) {
                fwrite(STDERR, "Error: --max-render-losses requires a non-negative integer\n");
                exit(2);
            }
            $i++;
            $options['maxRenderLosses'] = (int)$value;
        } elseif ($arg === '--roundtrip') {
            $options['roundTripMode'] = true;
        } elseif ($arg === '--smart-typography') {
            // The document-global switch the spec documents. Source mode is
            // for machine-facing output - text piped into something that
            // re-parses it - which is the shape of a CLI invocation.
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --smart-typography requires a mode (glyph|source|quotes-source)\n");
                exit(1);
            }
            $mode = $argv[++$i];
            if ($mode !== 'glyph' && $mode !== 'source' && $mode !== 'quotes-source') {
                fwrite(STDERR, "Error: Unknown smart typography mode: $mode (expected glyph|source|quotes-source)\n");
                exit(1);
            }
            $options['smartTypography'] = $mode;
        } elseif ($arg === '--include-root') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --include-root requires a directory\n");
                exit(1);
            }
            // Expanded here for the same reason as in runFlattenCommand().
            $options['includeRoot'] = absoluteIncludeRoot($argv[++$i]);
        } elseif ($arg === '-o' || $arg === '--output') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --output requires a filename\n");
                exit(1);
            }
            $options['output'] = $argv[++$i];
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "Error: Unknown option: $arg\n");
            fwrite(STDERR, "Try 'carve --help' for more information.\n");
            exit(1);
        } else {
            if ($input !== null) {
                fwrite(STDERR, "Error: Multiple input files specified\n");
                exit(1);
            }
            $input = $arg;
        }
    }

    return ['options' => $options, 'input' => $input];
}

/**
 * @param array<int, string> $argv
 * @return array{options: array<string, bool|string|null|array<int, string>>, input: ?string}
 */
/**
 * @param list<string> $argv
 * @return array<string, mixed>
 */
function parseLintArgs(array $argv): array
{
    $options = ['command' => 'lint', 'help' => false, 'files' => [], 'platforms' => [], 'extensions' => []];

    $argc = count($argv);
    for ($i = 2; $i < $argc; $i++) {
        $arg = $argv[$i];
        if ($arg === '-h' || $arg === '--help') {
            $options['help'] = true;
        } elseif ($arg === '--platform') {
            if (!isset($argv[$i + 1])) {
                fwrite(STDERR, "Error: --platform requires a name\n");
                exit(1);
            }
            $platform = $argv[++$i];
            assertKnownLintPlatform($platform);
            $options['platforms'][] = $platform;
        } elseif (str_starts_with($arg, '--platform=')) {
            $platform = substr($arg, strlen('--platform='));
            assertKnownLintPlatform($platform);
            $options['platforms'][] = $platform;
        } elseif ($arg === '--extension' || str_starts_with($arg, '--extension=')) {
            $extension = $arg === '--extension' ? ($argv[++$i] ?? null) : substr($arg, strlen('--extension='));
            if ($extension !== 'citations') {
                fwrite(STDERR, "Error: --extension expects citations\n");
                exit(1);
            }
            $options['extensions'][] = $extension;
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "Error: Unknown lint option: $arg\n");
            exit(1);
        } else {
            $options['files'][] = $arg;
        }
    }

    return ['options' => $options, 'input' => null];
}

/**
 * REFUSED here, while the programmatic API ignores an unknown name. The
 * asymmetry is deliberate: a misspelt flag that silently reported nothing would
 * be indistinguishable from a clean document, and an API caller has a type
 * checker where a command line has none.
 */
function assertKnownLintPlatform(string $platform): void
{
    $known = MarkdownHabitLinter::knownPlatforms();
    if (in_array($platform, $known, true)) {
        return;
    }

    fwrite(
        STDERR,
        sprintf(
            "Error: Unknown --platform value: %s (known: %s)\n",
            $platform,
            implode(', ', $known),
        ),
    );
    exit(1);
}

function parseFmtArgs(array $argv): array
{
    $files = [];
    $options = [
        'command' => 'fmt',
        'write' => false,
        'check' => false,
        'stamp' => false,
        'stampForm' => 'line',
        'migrate' => false,
        'help' => false,
        'files' => [],
    ];
    $argc = count($argv);
    for ($i = 2; $i < $argc; $i++) {
        $arg = $argv[$i];
        if ($arg === '-h' || $arg === '--help') {
            $options['help'] = true;
        } elseif ($arg === '-w' || $arg === '--write') {
            $options['write'] = true;
        } elseif ($arg === '--check') {
            $options['check'] = true;
        } elseif ($arg === '--migrate') {
            $options['migrate'] = true;
        } elseif ($arg === '--stamp') {
            $options['stamp'] = true;
            $options['stampForm'] = 'line';
        } elseif ($arg === '--stamp-block') {
            $options['stamp'] = true;
            $options['stampForm'] = 'block';
        } elseif (str_starts_with($arg, '-')) {
            fwrite(STDERR, "Error: Unknown fmt option: $arg\n");
            exit(1);
        } else {
            $files[] = $arg;
        }
    }
    if ($options['write'] && $options['check']) {
        fwrite(STDERR, "Error: fmt --write and --check are mutually exclusive\n");
        exit(1);
    }
    $options['files'] = $files;

    return ['options' => $options, 'input' => null];
}

function showHelp(): void
{
    echo <<<'HELP'
Carve - Render Carve markup

Usage:
  carve fmt [options] [files...]
  carve flatten [--include-root DIR] [file]
  carve merge [--json] base.crv ours.crv theirs.crv
  carve [options] [input-file]
  cat file.crv | carve [options]

Arguments:
  input-file          Input Carve file (reads from stdin if not specified)

Output format (default --html; last one wins):
  --html              HTML
  --markdown, --md    Markdown
  --plain, --plain-text  plain text
  --json, --ast          the parsed AST as JSON (see docs/ast-json.md)
  --stamp-info           report the document's provenance marker
  --stamp-check          exit 1 when the document predates this spec version
  --from-json            read an encoded AST instead of Carve source
  --ansi              ANSI-colored terminal text
  --carve             canonical Carve source

Rendering:
  --smart-typography MODE  glyph (default), source (all source runs),
                           quotes-source (quotes only); every presentation target
  --roundtrip              Preserve round-trip carriers in HTML or Markdown output
  --strict-losses          Refuse output when a raw format would be dropped
  --report-losses FILE     Write the machine-readable render-loss report (`-` for stderr)
  --allow-loss CODE        Permit raw-format-dropped, ruby-flattened,
                           editorial-comment-flattened, carrier-attribute-dropped,
                           list-style-dropped, list-delimiter-changed,
                           table-span-flattened, table-header-row-demoted,
                           table-header-row-hoisted or table-header-cell-demoted
                           (repeatable)
  --max-render-losses N    Bound detailed losses while retaining the full count (default 100)
  --report-conversion-diagnostics FILE
                           Write source conversion diagnostics (`-` for stderr; text targets only)
  --max-conversion-diagnostics N
                           Bound detailed conversion diagnostics (default 100)

Formatter:
  lint                Report markup that renders as something else: Markdown
                      habits, semantic span attributes that lose a value or sit
                      outside a span, and source written to a retired spelling
  lint --platform NAME
                      Also report host autolinks a platform re-linkifies
                      (repeatable; off unless named)
  lint --extension citations
                      Check placement of generated references
  fmt                 Format Carve source to stdout
  fmt -w, --write     Format files in place
  fmt --check         Exit non-zero if any file is not formatted
  fmt --migrate       Also respell a reference that misses its target only by
                      letter case, when exactly one target matches
  fmt --stamp         Append/replace a one-line provenance marker
  fmt --stamp-block   Append/replace a block provenance marker
  flatten             Write the document as ONE self-contained file, every
                      include expanded in place. The opposite of fmt, which
                      leaves directives alone so formatting returns the
                      author's document. Output is canonical Carve and
                      colliding explicit ids / footnote labels are renamed;
                      both are reported on stderr.

Migration (other markup to Carve, on stdout):
  migrate --from FORMAT   html, markdown (md), djot or bbcode
  migrate --from markdown --directory SOURCE --output TARGET
                         convert a Markdown folder and copy assets
  migrate --mode MODE     HTML only: safe (default), semantic or roundtrip
                          (roundtrip keeps unsupported HTML as raw {=html};
                          use it only for trusted input)
  migrate --adapter NAME  HTML only: the source generator (default generic)
  migrate --list-table    HTML only: write a table whose cells hold blocks as
                          ::: list-table instead of flattening its cells
  migrate --report FILE   write the v2 fidelity report as JSON (- is stderr)
  migrate --check-loss    exit 1 for degraded or dropped content; folder mode
                          also checks unresolved links and skipped entries

Options:
  -o, --output FILE   Write output to FILE instead of stdout
  -x, --xhtml         Use XHTML-compatible output (self-closing tags; HTML only)
  -s, --safe          Enable safe mode (sanitize dangerous HTML; HTML only)
  --no-includes       Leave include directives literal (--safe implies this)
  --static            Render in static mode: flatten interactive constructs
                      (tabs / code-group to labeled sections, mermaid / math to
                      source) so the HTML needs no client scripts. HTML only;
                      the bundled interactive extensions are auto-registered for
                      the HTML format so the difference is visible.
  --include-root DIR  Containment root for {{ path }} include directives.
                      A file input already defaults to the document's own
                      directory; this widens it, and it is the only way to
                      enable includes on stdin, which has no path context.
  -w, --warnings      Show parse warnings on stderr
  --strict            Exit with error code 1 if warnings are generated
  -h, --help          Show this help message
  -V, --version       Show version information

Examples:
  carve document.crv                    Render file to stdout (HTML)
  carve --static document.crv           Render self-contained static HTML
  carve --ansi document.crv             Render colored terminal output
  carve book/main.crv                   Expand includes against book/
  carve --include-root . book/main.crv  Widen the include root to the project
  carve flatten book/main.crv           Write it as ONE self-contained file
  carve --markdown document.crv         Render Markdown
  carve --carve document.crv            Render canonical Carve source
  carve fmt -w document.crv             Format file in place
  carve migrate --from djot notes.dj    Convert Djot to Carve on stdout
  carve document.crv -o document.html   Render to an output file
  echo '*hello*' | carve                Render from stdin

HELP;
}

function showVersion(): void
{
    echo 'carve-php ' . CarveConverter::LIB_VERSION . "\n";
}

// Main
if (($argv[1] ?? null) === 'flatten') {
    runFlattenCommand($argv);
}
if (($argv[1] ?? null) === 'merge') {
    runMergeCommand($argv);
}
if (($argv[1] ?? null) === 'migrate') {
    runMigrateCommand($argv);
}
$parsed = parseArgs($argv);
$options = $parsed['options'];
$inputFile = $parsed['input'];

if (($options['command'] ?? null) === 'lint') {
    if ($options['help']) {
        showHelp();
        exit(0);
    }

    $linter = new MarkdownHabitLinter();
    $semanticLinter = new SemanticAttributeLinter();
    $retiredLinter = new RetiredSpellingLinter();
    $tableColumnLinter = new TableColumnLinter();
    $delimitedTableLinter = new DelimitedTableLinter();
    $templateSourceLinter = new TemplateSourceLinter();
    $figureGroupLinter = new FigureGroupLinter();
    $quoteFenceLinter = new QuoteFenceLinter();
    $termFoldLinter = new DefinitionTermFoldLinter();
    $referencesPlacementLinter = new ReferencesPlacementLinter();
    $referenceLinter = new ReferenceLinter();
    $sourceLinter = new SourceLinter();
    $sources = [];

    if ($options['files'] === []) {
        $stdin = stream_get_contents(STDIN);
        if ($stdin === false) {
            fwrite(STDERR, "Error: Failed to read from stdin\n");
            exit(1);
        }
        $sources['-'] = $stdin;
    } else {
        foreach ($options['files'] as $file) {
            if (!is_file($file)) {
                fwrite(STDERR, "Error: File not found: $file\n");
                exit(1);
            }
            $sources[$file] = (string)file_get_contents($file);
        }
    }

    $found = 0;
    foreach ($sources as $name => $source) {
        // A CORE render, because that is what `carve` renders with unless the
        // caller builds a converter itself. The extension-aware reading is a
        // programmatic option rather than a flag: `carve` has no way to be told
        // which extensions the document will be published through.
        $warnings = array_merge(
            $linter->lint($source, ['platforms' => $options['platforms']]),
            $semanticLinter->lint($source),
            $referenceLinter->lint($source, ['extensions' => $options['extensions']]),
            $sourceLinter->lint($source),
            $retiredLinter->lint($source),
            $tableColumnLinter->lint($source),
            $delimitedTableLinter->lint($source),
            $templateSourceLinter->lint($source),
            $figureGroupLinter->lint($source),
            $quoteFenceLinter->lint($source),
            $termFoldLinter->lint($source),
            $referencesPlacementLinter->lint($source, ['extensions' => $options['extensions']]),
        );
        usort(
            $warnings,
            static fn ($a, $b): int => [$a->line, $a->column] <=> [$b->line, $b->column],
        );
        foreach ($warnings as $warning) {
            $found++;
            fwrite(STDOUT, sprintf(
                "%s:%d:%d %s %s\n",
                $name,
                $warning->line,
                $warning->column,
                $warning->rule,
                $warning->message,
            ));
        }
    }

    exit($found === 0 ? 0 : 1);
}

if (($options['command'] ?? null) === 'fmt') {
    if ($options['help']) {
        showHelp();
        exit(0);
    }
    $files = $options['files'];
    $exitCode = 0;
    $generatedBy = 'carve-php ' . CarveConverter::LIB_VERSION;
    if ($files === []) {
        $input = stream_get_contents(STDIN);
        if ($input === false) {
            fwrite(STDERR, "Error: Failed to read from stdin\n");
            exit(1);
        }
        $formatted = CarveConverter::toCarve(
            $options['migrate'] ? (new ReferenceLinter())->rewriteCaseOnlyReferences($input) : $input,
        );
        if ($options['stamp']) {
            $formatted = CarveConverter::stampCarve($formatted, $generatedBy, $options['stampForm']);
        }
        echo $formatted;
        exit(0);
    }
    foreach ($files as $file) {
        if (!is_string($file) || !is_file($file) || !is_readable($file)) {
            fwrite(STDERR, "Error: Cannot read file: $file\n");
            $exitCode = 1;

            continue;
        }
        $input = file_get_contents($file);
        if ($input === false) {
            fwrite(STDERR, "Error: Failed to read file: $file\n");
            $exitCode = 1;

            continue;
        }
        $formatted = CarveConverter::toCarve(
            $options['migrate'] ? (new ReferenceLinter())->rewriteCaseOnlyReferences($input) : $input,
        );
        if ($options['stamp']) {
            $formatted = CarveConverter::stampCarve($formatted, $generatedBy, $options['stampForm']);
        }
        if ($options['check']) {
            if ($formatted !== $input) {
                fwrite(STDERR, "$file is not formatted\n");
                $exitCode = 1;
            }

            continue;
        }
        if ($options['write']) {
            if (file_put_contents($file, $formatted) === false) {
                fwrite(STDERR, "Error: Failed to write file: $file\n");
                $exitCode = 1;
            }

            continue;
        }
        echo $formatted;
    }
    exit($exitCode);
}

if ($options['help']) {
    showHelp();
    exit(0);
}

if ($options['version']) {
    showVersion();
    exit(0);
}

// Read input
if ($inputFile !== null) {
    if (!file_exists($inputFile)) {
        fwrite(STDERR, "Error: File not found: $inputFile\n");
        exit(1);
    }
    if (!is_readable($inputFile)) {
        fwrite(STDERR, "Error: Cannot read file: $inputFile\n");
        exit(1);
    }
    $input = file_get_contents($inputFile);
    if ($input === false) {
        fwrite(STDERR, "Error: Failed to read file: $inputFile\n");
        exit(1);
    }
} else {
    // Read from stdin
    if (posix_isatty(STDIN)) {
        fwrite(STDERR, "Reading from stdin... (Ctrl+D to end, Ctrl+C to cancel)\n");
    }
    $input = stream_get_contents(STDIN);
    if ($input === false) {
        fwrite(STDERR, "Error: Failed to read from stdin\n");
        exit(1);
    }
}

if ($options['roundTripMode'] && !in_array($options['format'], ['html', 'markdown'], true)) {
    fwrite(STDERR, "Error: --roundtrip applies to --html or --markdown output only\n");

    exit(1);
}

// The stamp modes answer a question about the document rather than rendering it,
// so they short-circuit before any converter exists.
if ($options['format'] === 'stamp-info' || $options['format'] === 'stamp-check') {
    $stamp = Stamp::read($input);
    $current = CarveConverter::SPEC_VERSION;

    if ($stamp === null) {
        fwrite(STDOUT, "unstamped (spec version unknown; this engine targets $current)\n");
    } else {
        fwrite(STDOUT, sprintf(
            "carve-version: %s\ngenerated-by: %s\nthis engine targets: %s\n",
            $stamp['version'],
            $stamp['generatedBy'] ?? '(unrecorded)',
            $current,
        ));
    }

    if ($options['format'] === 'stamp-check' && Stamp::needsReview($input, $current)) {
        fwrite(STDERR, "Review the [behavior] changelog entries between that version and $current.\n");

        exit(1);
    }

    exit(0);
}

// Create converter. The non-HTML renderers (Markdown / plain text / ANSI) are
// their own converters; the --xhtml / --safe options are HTML-only and ignored
// for those formats.
$wantWarnings = $options['warnings'] || $options['strict'];
// The non-HTML factories take a pre-configured parser; pass a warnings-enabled
// one so --warnings / --strict work for every format (getWarnings() reads the
// parser). --xhtml / --safe stay HTML-only.
// Enable warning COLLECTION but not the parser's throw-on-error strict mode:
// --strict is enforced by the CLI below (non-zero exit when warnings exist),
// matching the HTML path.
$converter = match ($options['format']) {
    // PART 12 §4 requires `pos` on every node but the root, so the AST output
    // asks the parser to record them. Tracking is opt-in because it costs work
    // on every parse, and this is the only format that publishes the result.
    'json' => new CarveConverter(parser: new BlockParser($wantWarnings, false, false, true)),
    'markdown' => CarveConverter::markdown(new BlockParser($wantWarnings, false, false, true)),
    'plain' => CarveConverter::plainText(new BlockParser($wantWarnings, false, false, true)),
    'ansi' => CarveConverter::ansi(new BlockParser($wantWarnings, false, false, true)),
    // Positions ON: the writer orders collected definitions by the spans §4
    // records, and they are opt-in (carve-php#905).
    'carve' => CarveConverter::carve(new BlockParser($wantWarnings, false, false, true)),
    default => new CarveConverter(
        roundTripMode: $options['roundTripMode'],
        xhtml: $options['xhtml'],
        warnings: $wantWarnings,
        safeMode: $options['safe'] ? true : null,
        mode: $options['static'] ? RenderMode::STATIC : RenderMode::INTERACTIVE,
    ),
};

// Smart typography is a RENDERING choice, so it is set on the renderer rather
// than on the parse. Every presentation target carries the mode: HTML,
// Markdown, plain text and ANSI. The last two used to emit the glyph whatever
// the flag said, so `--smart-typography source` was accepted and ignored there
// (carve#560).
if ($options['roundTripMode']) {
    if ($converter->getRenderer() instanceof MarkdownRenderer) {
        $converter->getRenderer()->setRoundTripMode(true);
    }
}

if (($options['smartTypography'] ?? 'glyph') !== 'glyph') {
    $renderer = $converter->getRenderer();
    if (
        $renderer instanceof HtmlRenderer
        || $renderer instanceof MarkdownRenderer
        || $renderer instanceof PlainTextRenderer
        || $renderer instanceof AnsiRenderer
    ) {
        $renderer->setSmartTypography(SmartTypographyMode::from($options['smartTypography']));
    }
}

// Register the bundled interactive extensions for the HTML format so a sample
// that uses tabs / code-group / math / mermaid renders meaningfully in both
// modes and the --static difference is observable. The non-HTML renderers
// flatten these constructs natively, so they need no extension wiring here.
if ($options['format'] === 'html') {
    $converter->addExtension(new TabsExtension());
    $converter->addExtension(new CodeGroupExtension());
    $converter->addExtension(new MathBlockExtension());
    $converter->addExtension(new DetailsExtension());
    $converter->addExtension(new SpoilerExtension());
    $converter->addExtension(FencedRenderExtension::mermaid());
}

// Convert. --from-json reads an encoded AST instead of Carve source, so the
// parse step is replaced by a decode; every format then renders as usual.
$codec = new AstCodec();
try {
    $document = $options['fromJson'] ? $codec->decodeJson($input) : null;
} catch (JsonException | RuntimeException $exception) {
    // A malformed tree is user input like any other: report it on stderr and
    // exit 1 rather than dumping a PHP stack trace.
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");

    exit(1);
}

// File inclusion (PART 9 section 19). Opt-in by construction: the parser never
// touches the filesystem, so a directive is literal text until a host supplies
// a resolver - and here the host is this CLI.
//
// The containment root is an explicit --include-root, otherwise the DIRECTORY
// OF THE INPUT DOCUMENT. Never the process working directory, which is
// arbitrary with respect to the document and may be `/` or a home directory.
// Stdin has no path context and therefore no inferable root, so directives stay
// literal there unless --include-root names one.
//
// --carve is excluded on purpose: that target WRITES the document back as
// Carve, and inlining every child into it would hand back a different document
// than the one the author wrote. The writer preserves a directive verbatim for
// the same reason. --from-json is excluded because its input is a tree rather
// than source, with no path context to resolve against.
$includeRoot = $options['includeRoot'];
if ($includeRoot === null && $inputFile !== null) {
    $realInput = realpath($inputFile);
    $includeRoot = $realInput === false ? null : dirname($realInput);
}
$wantIncludes = $includeRoot !== null
    && !$options['noIncludes']
    && !$options['fromJson']
    && IncludeExpander::expandsForFormat((string)$options['format'])
    && ($options['includeRoot'] !== null || str_contains($input, '{{'));

if ($wantIncludes) {
    try {
        $resolver = new FilesystemIncludeResolver($includeRoot);
    } catch (RuntimeException $exception) {
        // An explicit root is a user request, so a bad one is fatal. An
        // INFERRED one is reachable without the user asking for includes at
        // all (a deleted parent directory, say), so it degrades to the plain
        // render rather than failing a render nobody asked to change.
        if ($options['includeRoot'] !== null) {
            fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");
            exit(1);
        }
        $resolver = null;
    }

    if ($resolver !== null) {
        $expander = new IncludeExpander(
            resolver: $resolver,
            currentPath: $inputFile === null ? null : (realpath($inputFile) ?: $inputFile),
        );
        $document = $expander->transform($converter->parse($input));
        // Include warnings are NOT behind --warnings. A refused directive stays
        // literal, which looks exactly like prose the author typed, so staying
        // quiet about it hides a real error behind something that reads as
        // normal text (spec I7).
        foreach ($expander->getWarnings() as $warning) {
            fwrite(STDERR, 'carve: ' . $warning->getMessage() . ' [' . ($warning->getRule() ?? 'include') . "]\n");
        }
        $suppressed = $expander->getSuppressedWarnings();
        if ($suppressed > 0) {
            fwrite(STDERR, "carve: $suppressed further include warning(s) suppressed\n");
        }
    }
}

try {
    $conversionWriter = null;
    if ($options['reportConversionDiagnostics'] !== null) {
        $renderer = $converter->getRenderer();
        if (!$renderer instanceof ConversionDiagnosticCollector) {
            fwrite(STDERR, "Error: --report-conversion-diagnostics requires --carve, --markdown, --plain or --ansi\n");
            exit(2);
        }
        $conversionWriter = $renderer;
        $conversionWriter->beginConversionDiagnosticCollection($options['maxConversionDiagnostics']);
    }
    if ($options['format'] === 'json') {
        $output = $codec->encodeJson(
            $document ?? $converter->parse($input),
            JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE,
            true,
        ) . "\n";
    } elseif ($document !== null) {
        $checked = $converter->renderWithReport($document, false, $options['maxRenderLosses']);
        $output = $checked->value;
    } else {
        $checked = $converter->convertWithReport($input, false, $options['maxRenderLosses']);
        $output = $checked->value;
    }
} catch (RenderDepthExceededException | SourceUnspellableException $exception) {
    // A renderer that reaches its ceiling REFUSES (PART 9 §25). The CLI reports
    // the refusal and exits non-zero rather than printing a partial document -
    // or a PHP stack trace, which tells the caller as little as truncation did.
    fwrite(STDERR, 'Error: ' . $exception->getMessage() . "\n");

    exit(1);
}
$conversionReport = $conversionWriter?->finishConversionDiagnosticCollection();

// Handle warnings
$exitCode = 0;
$checked ??= new RenderResult($output, [], 0, false);
if ($options['allowLoss'] !== []) {
    $allowedCodes = array_unique($options['allowLoss']);
    $allowedTotal = 0;
    foreach ($allowedCodes as $code) {
        $allowedTotal += $checked->lossCounts[$code] ?? 0;
    }
    $losses = array_values(array_filter(
        $checked->losses,
        static fn (array $loss): bool => !in_array($loss['code'], $allowedCodes, true),
    ));
    $totalLosses = $checked->totalLosses - $allowedTotal;
    $checked = new RenderResult($checked->value, $losses, $totalLosses, $totalLosses > count($losses));
}
if ($checked->totalLosses > 0) {
    foreach ($checked->losses as $loss) {
        $pos = isset($loss['pos']) ? ':' . $loss['pos']['startLine'] . ':' . $loss['pos']['startColumn'] : '';
        fwrite(STDERR, ($inputFile ?? '<stdin>') . $pos . ' ' . $loss['code'] . ' - ' . $loss['message'] . "\n");
    }
    fwrite(STDERR, sprintf("%s: %d render loss%s\n", $inputFile ?? '<stdin>', $checked->totalLosses, $checked->totalLosses === 1 ? '' : 'es'));
}
if ($options['reportLosses'] !== null) {
    $report = json_encode(['losses' => $checked->losses, 'totalLosses' => $checked->totalLosses, 'truncated' => $checked->truncated], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
    if ($options['reportLosses'] === '-') {
        fwrite(STDERR, $report);
    } elseif (file_put_contents($options['reportLosses'], $report) === false) {
        fwrite(STDERR, "Error: Failed to write render-loss report\n");
        exit(2);
    }
}
if ($options['reportConversionDiagnostics'] !== null) {
    $report = json_encode($conversionReport, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
    if ($options['reportConversionDiagnostics'] === '-') {
        fwrite(STDERR, $report);
    } elseif (file_put_contents($options['reportConversionDiagnostics'], $report) === false) {
        fwrite(STDERR, "Error: Failed to write conversion diagnostics\n");
        exit(2);
    }
}
if ($options['strictLosses'] && $checked->totalLosses > 0) {
    exit(1);
}
if ($options['warnings'] || $options['strict']) {
    $warnings = $converter->getWarnings();
    foreach ($warnings as $warning) {
        fwrite(STDERR, "Warning: $warning\n");
    }
    if ($options['strict'] && count($warnings) > 0) {
        $exitCode = 1;
    }
}

// Write output
writeRendered($output, $options['output'] !== null ? (string)$options['output'] : null);

exit($exitCode);
